{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "paths": {
      "@gh/iot-contract": ["../../packages/iot-contract/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../packages/iot-contract/src/**/*.ts"]
}
