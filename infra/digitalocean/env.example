# ── IoT Gateway（DigitalOcean App Platform 環境變數）──
STORE=postgres
DATABASE_URL=postgresql://user:pass@host:25060/ghiot?sslmode=require
REDIS_URL=rediss://default:pass@host:25061
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITE_MASTER_KEY=
PLATFORM_SECRET=
# 32 bytes base64：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=
WEBHOOK_URL=https://pickle-heaven.vercel.app/api/iot/webhook
WEBHOOK_SECRET=
MAX_WAIT_SEC=25
OFFLINE_AFTER_SEC=90
DEFAULT_COMMAND_TTL_SEC=30
REDELIVER_AFTER_SEC=20
RATE_LIMIT_PER_MIN=240

# ── 顧好平台（Vercel 環境變數）── 值要與上面對應
IOT_GATEWAY_URL=https://<app>.ondigitalocean.app
IOT_PLATFORM_SECRET=<同 PLATFORM_SECRET>
IOT_WEBHOOK_SECRET=<同 WEBHOOK_SECRET>
