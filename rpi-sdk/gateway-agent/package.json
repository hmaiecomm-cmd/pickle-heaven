{
  "name": "pickle-heaven-gateway-agent",
  "version": "1.0.0",
  "description": "Pickle Heaven Gateway Agent - MQTT 命令處理與 RS-485 控制",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:simulation": "NODE_ENV=simulation node dist/index.js",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:simulation": "npm run build && npm run start:simulation",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "mqtt": "^5.3.3",
    "serialport": "^12.0.0",
    "@serialport/parser-delimiter": "^12.0.0",
    "sqlite3": "^5.1.6",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "date-fns": "^2.30.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
