# Builds the static web UI into a Caddy image (alternative to bind-mounting web/dist).
FROM node:20-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM caddy:2.8-alpine
COPY --from=build /web/dist /srv/web
COPY services/reverse-proxy/Caddyfile /etc/caddy/Caddyfile
