# Edge agent image: Python 3.12 + FFmpeg (used as supervised child processes for transcoding / test sources).
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --create-home edge \
 && mkdir -p /var/lib/edge-control /var/cache/edge-control /etc/edge-control \
 && chown -R edge:edge /var/lib/edge-control /var/cache/edge-control

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install .

USER edge
EXPOSE 8000
# Single process on purpose: one owner per serial port. Never add --workers.
CMD ["python", "-m", "edge_control.main"]
