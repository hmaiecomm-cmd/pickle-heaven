{
  "name": "pickle-heaven",
  "version": "1.0.0",
  "private": true,
  "description": "匹克精靈 — Pickleball court booking platform for Taiwan (LINE MINI App / LIFF)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-prisma.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/generate-prisma.mjs",
    "db:push": "echo \"Turso 請改用 npm run db:turso:init（見 README）\" && exit 1",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/guard-not-production.mjs && node scripts/reset-turso.mjs && npm run db:turso:init && npm run db:seed",
    "db:studio": "prisma studio",
    "setup": "npm run db:turso:init && npm run db:seed",
    "postinstall": "node scripts/generate-prisma.mjs",
    "db:turso:init": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/turso-init.sql && node scripts/apply-turso-sql.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "admin:password": "node scripts/set-admin-password.mjs",
    "verify:schedule": "tsx scripts/verify-schedule.mts",
    "verify:session": "tsx -r ./scripts/stub-server-only.cjs scripts/verify-session-logic.mts",
    "dev:clean": "node scripts/clean-next.mjs && next dev",
    "verify:lifecycle": "tsx -r ./scripts/stub-server-only.cjs scripts/verify-session-lifecycle.mts",
    "sync": "node scripts/sync-to-dropbox.mjs",
    "dev:fill": "tsx -r ./scripts/stub-server-only.cjs scripts/fill-session.mts",
    "vercel:env": "node scripts/push-env-to-vercel.mjs",
    "verify:db": "node scripts/verify-db-isolation.mjs",
    "dropbox:ignore": "node scripts/dropbox-ignore.mjs",
    "verify:activities": "tsx -r ./scripts/stub-server-only.cjs --env-file=.env scripts/test-activities.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@libsql/client": "^0.18.0",
    "@line/liff": "^2.24.0",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.474.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
